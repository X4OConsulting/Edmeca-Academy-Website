# Docker stack configuration — copy to .env.docker (gitignored) to override.
# The npm `docker:*` / `stack:*` scripts load it via `--env-file .env.docker`;
# every value here has the same default baked into docker-compose.yml, so the
# stack also runs with no .env.docker at all.
#
# The defaults point at the LOCAL Supabase stack (`npx supabase start`).
# The anon/service keys below are Supabase's standard local development demo
# keys — public by design, valid only against a local stack, safe to commit.

# --- Browser-facing Supabase (what the web app bundle uses) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Functions-container-facing Supabase ---
# host.docker.internal reaches the local Supabase stack published on the host.
# For cloud Supabase, set this to the same https:// URL as VITE_SUPABASE_URL.
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Auth toggles ---
VITE_ENABLE_LOGIN=true
# true = portal reachable without signing in (preview mode). Set to false to
# exercise the real Supabase auth flow against the local stack.
VITE_BYPASS_AUTH=true

# --- Optional integrations ---
# Groq key for the /api/chat assistant (blank = chat returns an error).
GROQ_API_KEY=
# Deployed AI API for the Financial Analysis tool (blank = tool disabled).
# e.g. https://edmeca-academy-website.vercel.app
VITE_AI_API_URL=
