# EDMECA Academy environment variables
#
# Real values live in the Vercel project (team raymond-3084s-projects,
# project edmeca-academy-website). For local work:
#   vercel link && vercel env pull .env.local
# .env.local sits in the repo root (vite.config.ts reads env from there).

# Database: Neon Postgres (set by the Vercel Neon integration)
DATABASE_URL=postgres://user:password@host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/neondb?sslmode=require

# Auth: Better Auth (server/auth.ts)
BETTER_AUTH_SECRET=generate_a_long_random_secret_here
BETTER_AUTH_URL=http://localhost:3999
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: Resend, domain edmeca.co.za
RESEND_API_KEY=
EMAIL_FROM=EDMECA Academy <noreply@edmeca.co.za>
FORMS_NOTIFY_TO=info@edmeca.co.za

# AI
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Diagnostic report elaboration (optional; without it the template report is sent)
EDMECA_DEEPSEEK_API=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=15000

# Diagnostics: Google Apps Script delivery (sheet rows + report emails)
EXECUTION_GAP_SCRIPT_URL=
EXECUTION_GAP_SHARED_SECRET=
# AI Map falls back to the Execution Gap script when these are empty
AI_MAP_SCRIPT_URL=
AI_MAP_SHARED_SECRET=
AI_MAP_SCRIPT_TIMEOUT_MS=22000
ASSESSMENT_SCRIPT_URL=
ASSESSMENT_SHARED_SECRET=

# Front end (VITE_ values are public: they are built into the browser bundle)
VITE_ENABLE_LOGIN=true
VITE_BYPASS_AUTH=false
