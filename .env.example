# EDMECA Academy Environment Variables
# 
# IMPORTANT: For this project, environment variables should be placed in client/.env.local
# because Vite uses client/ as the root directory.
#
# Copy this file to client/.env.local and update with your actual values

# Supabase Configuration (Required for database and authentication)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Execution Gap Diagnostic (server-side only; configure in Netlify)
EXECUTION_GAP_SCRIPT_URL=your_google_apps_script_web_app_url_here
EXECUTION_GAP_SHARED_SECRET=generate_a_long_random_secret_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Session Configuration (Legacy - still needed for development)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Development Configuration
NODE_ENV=development
PORT=5000
