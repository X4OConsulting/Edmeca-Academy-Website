# EDMECA Academy Environment Variables
# 
# IMPORTANT: For this project, environment variables should be placed in client/.env.local
# because Vite uses client/ as the root directory.
#
# Copy this file to client/.env.local and update with your actual values

# Supabase Configuration (Required for database and authentication)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Execution Gap Diagnostic (server-side only; configure in Netlify)
EXECUTION_GAP_SCRIPT_URL=your_google_apps_script_web_app_url_here
EXECUTION_GAP_SHARED_SECRET=generate_a_long_random_secret_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Execution Gap report elaboration (optional, server-side only).
# Without DEEPSEEK_API_KEY the deterministic template report is sent, so the
# diagnostic keeps working; the key only makes the emailed report fuller.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# deepseek-flash (default, cheapest) or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# Hard ceiling on the model call; Netlify sync functions allow 60s
DEEPSEEK_TIMEOUT_MS=15000

# Session Configuration (Legacy - still needed for development)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Development Configuration
NODE_ENV=development
PORT=5000
