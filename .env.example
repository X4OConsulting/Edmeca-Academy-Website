# EDMECA Academy Environment Variables
# 
# IMPORTANT: Place environment variables in .env.local at the REPO ROOT —
# vite.config.ts sets envDir to the project root (not client/).
#
# Copy this file to .env.local and update with your actual values.
# For the Docker stack, use .env.docker instead (see .env.docker.example).

# Supabase Configuration (Required for database and authentication)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Session Configuration (Legacy - still needed for development)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Development Configuration
NODE_ENV=development
PORT=5000
